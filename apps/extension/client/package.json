{
  "name": "client-ext-animevsub-helper",
  "version": "1.0.51",
  "description": "This package is a client that includes connections to the AnimeVsub Helper utility",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git://github.com/anime-vsub/extension-animevsub-helper"
  },
  "keywords": [
    "animevsub-helper"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "nx": {
    "targets": {
      "build": {
        "cache": true,
        "inputs": [
          "production",
          "{workspaceRoot}/apps/extension/src/shared/**/*",
          "{workspaceRoot}/apps/extension/package.json"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ]
      },
      "typecheck": {
        "cache": true,
        "inputs": [
          "production",
          "{workspaceRoot}/apps/extension/src/shared/**/*",
          "{workspaceRoot}/apps/extension/package.json"
        ]
      },
      "nx-release-publish": {
        "dependsOn": [
          "build"
        ]
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "devDependencies": {
    "tsdown": "0.23.7"
  }
}
