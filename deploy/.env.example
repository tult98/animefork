# Copy to deploy/.env on the server. Never commit the real file.
# The URL people open in the browser, no trailing slash. Baked into the web bundle.
PUBLIC_URL=https://animefork.com
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# Required: the API will not start without it.
TMDB_API_KEY=
# Optional:
TYPESAFE_API_KEY=
DEEPSEEK_API_KEY=
MAL_CLIENT_ID=
# RATE_LIMIT_PER_MINUTE=60
