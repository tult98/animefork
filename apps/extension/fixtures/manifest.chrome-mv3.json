{
  "manifest_version": 3,
  "name": "AnimeVsub Helper",
  "version": "1.0.50",
  "description": "Extension add API helper for AnimeVsub",
  "background": {
    "service_worker": "./dist/background/index.mjs"
  },
  "icons": {
    "16": "./assets/icon-512.png",
    "48": "./assets/icon-512.png",
    "128": "./assets/icon-512.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "cookies",
    "declarativeNetRequest",
    "storage"
  ],
  "host_permissions": ["*://*/*"],
  "content_scripts": [
    {
      "matches": [
        "http://animevsub.netlify.app/*",
        "https://animevsub.netlify.app/*",
        "http://animevsub.eu.org/*",
        "https://animevsub.eu.org/*",
        "http://m.animevsub.eu.org/*",
        "https://m.animevsub.eu.org/*",
        "http://vuitruyen.netlify.app/*",
        "https://vuitruyen.netlify.app/*",
        "http://vuitruyen.eu.org/*",
        "https://vuitruyen.eu.org/*",
        "http://mangaraiku.eu.org/*",
        "https://mangaraiku.eu.org/*",
        "http://m.mangaraiku.eu.org/*",
        "https://m.mangaraiku.eu.org/*",
        "http://raiku.eu.org/*",
        "https://raiku.eu.org/*",
        "http://mraiku.eu.org/*",
        "https://mraiku.eu.org/*",
        "http://raiku.netlify.app/*",
        "https://raiku.netlify.app/*",
        "http://mangaraiku.netlify.app/*",
        "https://mangaraiku.netlify.app/*",
        "http://tariteam.github.io/download-video/*",
        "https://tariteam.github.io/download-video/*",
        "http://example.com/*",
        "https://example.com/*",
        "http://localhost/*",
        "https://localhost/*",
        "http://ihentai.netlify.app/*",
        "https://ihentai.netlify.app/*",
        "http://ihentai.eu.org/*",
        "https://ihentai.eu.org/*",
        "http://cinevsub.netlify.app/*",
        "https://cinevsub.netlify.app/*",
        "http://cinevsub.eu.org/*",
        "https://cinevsub.eu.org/*",
        "http://cinevsub.pages.dev/*",
        "https://cinevsub.pages.dev/*",
        "http://cinevsub.nuxt.dev/*",
        "https://cinevsub.nuxt.dev/*"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "js": ["./dist/contentScripts/index.global.js"]
    },
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "run_at": "document_start",
      "js": ["./dist/contentScripts/inject.global.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "dist/contentScripts/inject2.global.js",
        "dist/contentScripts/embed.global.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
