{
  "name": "extension-animevsub-helper",
  "displayName": "AnimeVsub Helper",
  "description": "Extension add API helper for AnimeVsub",
  "version": "1.0.50",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "dev": "web-ext run --source-dir dist/chrome-mv3 --target chromium",
    "dev:firefox": "web-ext run --source-dir dist/firefox-mv3 --target firefox-desktop",
    "test": "vitest run",
    "lint": "eslint .",
    "pack": "web-ext build --source-dir dist/chrome-mv3 --artifacts-dir artifacts --filename animevsub-helper-chrome-mv3-{version}.zip --overwrite-dest && web-ext build --source-dir dist/firefox-mv3 --artifacts-dir artifacts --filename animevsub-helper-firefox-mv3-{version}.xpi --overwrite-dest && crx pack dist/chrome-mv3 -o artifacts/animevsub-helper-chrome-mv3.crx"
  },
  "nx": {
    "targets": {
      "build": {
        "cache": true,
        "inputs": [
          "production"
        ],
        "outputs": [
          "{projectRoot}/dist",
          "{projectRoot}/client/dist"
        ]
      },
      "watch": {
        "continuous": true
      },
      "dev": {
        "continuous": true,
        "dependsOn": [
          "build",
          "watch"
        ]
      },
      "dev:firefox": {
        "continuous": true,
        "dependsOn": [
          "build",
          "watch"
        ]
      },
      "test": {
        "cache": true,
        "inputs": [
          "default"
        ]
      },
      "pack": {
        "dependsOn": [
          "build"
        ],
        "outputs": [
          "{projectRoot}/artifacts"
        ]
      },
      "lint": {
        "cache": true,
        "inputs": [
          "default",
          "{projectRoot}/eslint.config.mjs"
        ]
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tachibana-shin/webext-bridge": "6.0.0-rc3",
    "@types/chrome": "0.3.6",
    "@types/cookie": "0.5.1",
    "@types/webextension-polyfill": "0.12.6",
    "cookie": "0.5.0",
    "crx": "5.0.1",
    "eslint": "10.13.0",
    "js-base64": "3.7.8",
    "tsdown": "0.23.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "web-ext": "10.8.0",
    "webextension-polyfill": "0.9.0"
  }
}
