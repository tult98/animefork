{
  "name": "art-sync",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync": "node --env-file-if-exists=.env src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "nx": {
    "targets": {
      "typecheck": {
        "cache": true,
        "inputs": [
          "default",
          "^production"
        ]
      },
      "lint": {
        "cache": true,
        "inputs": [
          "default",
          "{projectRoot}/eslint.config.mjs"
        ]
      },
      "test": {
        "cache": true,
        "inputs": [
          "default",
          "^production"
        ]
      }
    }
  },
  "dependencies": {
    "pg": "8.16.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/pg": "8.15.5",
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "globals": "17.13.0",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12"
  }
}
