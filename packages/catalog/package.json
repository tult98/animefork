{
  "name": "catalog",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "nx": {
    "targets": {
      "build": {
        "cache": true,
        "inputs": [
          "production",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ]
      },
      "typecheck": {
        "cache": true,
        "inputs": [
          "default",
          "^production"
        ]
      },
      "lint": {
        "cache": true,
        "inputs": [
          "default",
          "{projectRoot}/eslint.config.mjs"
        ]
      },
      "test": {
        "cache": true,
        "inputs": [
          "default",
          "^production"
        ]
      }
    }
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "domhandler": "5.0.3",
    "eslint": "10.14.0",
    "globals": "17.13.0",
    "tsdown": "0.23.7",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12"
  }
}
