# Caddy gets and renews the HTTPS certificate for this hostname on its own, and
# redirects plain HTTP to it. www redirects to the bare domain.
www.animefork.com {
	redir https://animefork.com{uri} permanent
}

animefork.com {
	encode zstd gzip

	@api path /v1/* /healthz
	handle @api {
		reverse_proxy api:3100
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
