{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "verify": "node scripts/verify.ts",
    "capture-fixtures": "node scripts/capture-fixtures.ts",
    "tokens": "node scripts/build-tokens.ts"
  },
  "nx": {
    "targets": {
      "dev": {
        "continuous": true
      },
      "build": {
        "cache": true,
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "production",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ]
      },
      "typecheck": {
        "cache": true,
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "default",
          "^production"
        ]
      },
      "lint": {
        "cache": true,
        "inputs": [
          "default",
          "{projectRoot}/eslint.config.mjs"
        ]
      },
      "test": {
        "cache": true,
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "default",
          "^production"
        ]
      },
      "tokens": {
        "inputs": [
          "{projectRoot}/src/design/tokens.json",
          "{projectRoot}/scripts/build-css.ts",
          "{projectRoot}/scripts/build-tokens.ts"
        ],
        "outputs": [
          "{projectRoot}/src/design/tokens.css",
          "{projectRoot}/src/design/theme.css"
        ]
      },
      "verify": {
        "dependsOn": [
          "^build"
        ],
        "outputs": [
          "{projectRoot}/artifacts/verify"
        ]
      }
    }
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource/archivo": "5.3.0",
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-router": "1.170.46",
    "client-ext-animevsub-helper": "workspace:*",
    "hls.js": "1.5.9",
    "lucide-react": "1.61.0",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fetch-mock/vitest": "0.2.18",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/router-plugin": "1.168.48",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "22.1.0",
    "tailwindcss": "4.3.5",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.7",
    "vitest": "4.1.12"
  }
}
